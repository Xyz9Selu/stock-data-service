# PostgreSQL
# Host-side app: POSTGRES_HOST=127.0.0.1 POSTGRES_PORT=15432 (compose publish)
# Inside docker compose api container these are overridden to host=db port=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_PUBLISH_PORT=15432
POSTGRES_DB=stock_data
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me

# API
APP_HOST=0.0.0.0
APP_PORT=8002

# Tushare (required for /v1/* on-demand queries)
TUSHARE_TOKEN=your-tushare-token

# On-demand query disk cache
# In Docker this is set to /data/cache; host path is bind-mounted from ./data/cache
DATA_ROOT=./data/cache
TUSHARE_MIN_INTERVAL=0.35
TUSHARE_REPORT_RC_INTERVAL=61
CACHE_TTL_HOURS=24
